# Writes a C source holding a binary file, so every frontend can carry the
# About picture without platform resources.
#   cmake -DINPUT=<file> -DOUTPUT=<source.c> -DNAME=<symbol> -P embed_file.cmake
file(READ "${INPUT}" _content HEX)
string(LENGTH "${_content}" _length)
math(EXPR _size "${_length} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_content}")
# Keep lines short for compilers with physical line limits.
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" _bytes "${_bytes}")
file(WRITE "${OUTPUT}" "/* Generated by embed_file.cmake. */\n#include <stddef.h>\nconst unsigned char ${NAME}[] = {\n${_bytes}\n};\nconst size_t ${NAME}_size = ${_size};\n")
